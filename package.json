{
  "name": "browser-nova",
  "version": "0.2.0",
  "description": "Browser Nova — Desktop browser for HTTP, Web Inspection, and AI Automation",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "test:fixture": "node dist/fixtures/server.js",
    "test:unit": "node dist/tests/unit-test.js",
    "test": "npm run typecheck && node scripts/build.mjs && node dist/tests/unit-test.js && node dist/tests/smoke-test.js && npm run test:updates && node --test dist/tests/extension-test.js",
    "cli": "node dist/packages/cli/bin.js",
    "dist:mac": "node scripts/package-mac.mjs --arm64",
    "dist:mac:universal": "node scripts/package-mac.mjs --universal",
    "release:mac": "node scripts/package-mac.mjs --release --universal",
    "test:updates": "node --test dist/tests/update-test.js tests/release-config.test.cjs",
    "test:extensions": "npm run build:main && electron dist/tests/extension-integration.js"
  },
  "keywords": [
    "browser",
    "electron",
    "automation",
    "ai",
    "cdp",
    "inspector"
  ],
  "author": "Browser Nova Team",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/novaosai-lab/browser-nova.git"
  },
  "homepage": "https://github.com/novaosai-lab/browser-nova"
}
